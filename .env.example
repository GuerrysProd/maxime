# Variables d’environnement du site — copier en .env.local (jamais versionné) et compléter.
# Sans valeur, le site fonctionne en mode local : e-mails écrits dans la console, créneaux d’exemple.

# Adresse publique du site, sans barre finale (balises canoniques, partage). Par défaut : http://localhost:3000
NEXT_PUBLIC_SITE_URL=

# --- Formulaire « Démarrer un projet » (app/contact/actions.ts) ---
# Clé API Resend (https://resend.com). Absente : les e-mails sont écrits dans la console.
RESEND_API_KEY=
# Expéditeur, sur un domaine vérifié dans Resend. Ex. : Maxime Vallat <contact@domaine.fr>
CONTACT_FROM_EMAIL=
# Destinataire des demandes. Par défaut : l’e-mail de content/fr/site.json.
CONTACT_TO_EMAIL=

# --- Prise de rendez-vous (lib/booking) ---
# Créneaux libres lus dans Cal.com (API v2). Absents : créneaux d’exemple.
CALCOM_API_KEY=
CALCOM_EVENT_TYPE_ID=
# Page de réservation ouverte par le bouton « Réserver » (Cal.com, Calendly…).
# La date et le créneau choisis sont ajoutés en paramètres (?date=…&slot=…).
NEXT_PUBLIC_BOOKING_URL=
